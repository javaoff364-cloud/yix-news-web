{
  "name": "yixnews",
  "version": "1.0.1",
  "description": "Official JavaScript, TypeScript and CLI client for the YIX News API",
  "type": "module",
  "main": "./src/index.js",
  "module": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    }
  },
  "bin": {
    "yixnews": "./bin/yixnews.js"
  },
  "files": ["src", "bin", "README.md", "TERMUX.md", "LICENSE"],
  "engines": { "node": ">=18" },
  "scripts": {
    "test": "node --test && npm run test:types",
    "test:types": "npx --yes --package typescript tsc --noEmit --strict --target ES2022 --module NodeNext --moduleResolution NodeNext --lib ES2022,DOM test/types.test.ts",
    "prepublishOnly": "npm test"
  },
  "keywords": ["yixnews", "news", "news-api", "uzbekistan", "cli", "typescript"],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/javaoff364-cloud/yix-news-web.git",
    "directory": "packages/javascript"
  },
  "homepage": "https://yixnews.vercel.app/docs.html",
  "bugs": { "url": "https://github.com/javaoff364-cloud/yix-news-web/issues" }
}